{
  "name": "@local/dsh-discussion-plaza",
  "version": "0.1.0",
  "private": true,
  "description": "User-level plugin: a cross-workspace discussion plaza. Each discussion is one Markdown document with a leased write lock, a status machine (writing / closing / closed), and agent tools so sessions from different workspaces can talk to each other.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "jsdom": "^24.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "license": "MIT"
}
