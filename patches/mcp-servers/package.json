{
  "name": "@local/dsh-client-mcp-servers",
  "version": "0.2.0",
  "private": true,
  "description": "Umbrella bundle: one settings page holding a list of external MCP servers, each mounted as a child of the official @deepseek-ai/dsh-mcp-client",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "*",
    "@deepseek-ai/dsh-mcp-client": "*",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT"
}
