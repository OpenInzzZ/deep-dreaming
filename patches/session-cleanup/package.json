{
  "name": "@local/dsh-plugin-session-cleanup",
  "version": "0.3.0",
  "private": true,
  "description": "User-level plugin: manually delete archived dsh sessions to reclaim disk space, from a settings page list and a session context-menu action. Confirmation first; no automatic cleanup.",
  "type": "module",
  "main": "session-cleanup.mjs",
  "exports": {
    ".": "./session-cleanup.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "files": [
    "session-cleanup.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cosmokit": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "jsdom": "^24.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "license": "MIT"
}
