{
  "name": "@local/dsh-todo-board",
  "version": "0.1.0",
  "private": true,
  "description": "User-level plugin: one cross-project TODO / DONE / feature-branch board shared by every workspace, readable and writable through agent tools, with Markdown mirrors in the taikoo-saas TODO.md / DONE.md / 功能分支整理.md format.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "jsdom": "^24.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "license": "MIT"
}