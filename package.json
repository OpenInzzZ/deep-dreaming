{
  "name": "deep-dreaming",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "User-level DeepSeek Harness (dsh) patch set: per-patch plugins, tests, and the install/deploy tooling around ~/.dsh",
  "license": "MIT",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "install:patches": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "deploy:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "migrate:memory": "node scripts/migrate-dsh-memory.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "jsdom": "^24.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
